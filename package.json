{
  "name": "@hugesb/dsh-stream-agent",
  "version": "0.3.2",
  "license": "Apache-2.0",
  "type": "module",
  "description": "单流协议 DSH 插件（独立模式）：专用 profile + 计量治理 + tf-code 收口 + 编辑/搜索/计划/恢复/段边界（含会话日志 v4 工具生命周期与 model source 修复）",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "ai-agent",
    "token-optimization",
    "single-stream"
  ],
  "author": "54dsb1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/54dsb1/dsh-stream-agent.git"
  },
  "homepage": "https://github.com/54dsb1/dsh-stream-agent#readme",
  "bugs": {
    "url": "https://github.com/54dsb1/dsh-stream-agent/issues"
  },
  "main": "./dist/entry/loop.js",
  "exports": {
    ".": "./dist/entry/loop.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\" \"test/kernel/*.test.ts\"",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-consistency.mjs",
    "gate": "node scripts/gate.mjs",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run"
  },
  "engines": {
    "node": ">=22.18",
    "dsh": ">=0.2.2-rc.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "dist/",
    "ui/",
    "src/",
    "test/",
    "scripts/",
    "docs/",
    "eval/METRICS.md",
    "eval/RESULTS.md",
    "eval/tasks/",
    "eval/tools/",
    "profiles/",
    "preset/",
    "preset.yml",
    "cordis.patch.yml",
    "patches/"
  ],
  "bin": {
    "dsh-stream-agent": "./dist/entry/control-bar-cli.js"
  }
}
